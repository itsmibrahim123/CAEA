# ============================================================
# CAEA Institute - Production Server Configuration (Hostinger / Apache / LiteSpeed)
# ============================================================

# 1. Directory Index Priority (Ensures index.html loads over Hostinger's default.php)
DirectoryIndex index.html index.php

# 2. Prevent directory indexing & follow symbolic links
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
Options +FollowSymLinks

# 3. Default Charset & MIME Types for Modern Assets
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/quicktime .mov
    AddType application/json .json
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddType text/xml .xml
</IfModule>

# 4. URL Rewriting & Clean Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Strip index.html from URL address bar
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ / [R=301,L]

    # Case-insensitive rewrites for asset directories (Linux server compatibility)
    RewriteRule ^Assets/(.*)$ assets/$1 [NC,L]
    RewriteRule ^assets/Team/(.*)$ assets/team/$1 [NC,L]
    RewriteRule ^assets/Allies/(.*)$ assets/allies/$1 [NC,L]
    RewriteRule ^assets/Video/(.*)$ assets/video/$1 [NC,L]
    RewriteRule ^assets/Media/(.*)$ assets/media/$1 [NC,L]
    RewriteRule ^assets/Css/(.*)$ assets/css/$1 [NC,L]
    RewriteRule ^assets/Js/(.*)$ assets/js/$1 [NC,L]

    # Legacy Root Assets / Styles / Scripts Rewrites
    RewriteRule ^styles\.css$ assets/css/styles.css [L]
    RewriteRule ^home\.css$ assets/css/home.css [L]
    RewriteRule ^script\.js$ assets/js/script.js [L]
    RewriteRule ^data-store\.js$ assets/js/data-store.js [L]
    RewriteRule ^device-detect\.js$ assets/js/device-detect.js [L]
    RewriteRule ^analytics\.js$ assets/js/analytics.js [L]

    # Clean Routes
    RewriteRule ^our-story/?$ pages/our-story.html [L]
    RewriteRule ^our-stories/?$ pages/our-story.html [L]
    RewriteRule ^our-work/?$ pages/our-work.html [L]
    RewriteRule ^activities/?$ pages/our-work.html [L]
    RewriteRule ^our-analytics/?$ https://dashboard.climateactionenergyaccess.com/ [R=301,L]
    RewriteRule ^pages/our-analytics\.html$ https://dashboard.climateactionenergyaccess.com/ [R=301,L]
    RewriteRule ^get-involved/?$ pages/get-involved.html [L]
    RewriteRule ^admin/?$ admin/index.html [L]
</IfModule>

# 5. Browser Caching & Instant Update Headers (Prevents stale code on refresh)
<IfModule mod_headers.c>
    # HTML and PHP files: never cache so live updates show immediately
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # CSS and JavaScript: revalidate so changes reflect without hard refresh
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
