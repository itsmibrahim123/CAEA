{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/our-story",
      "destination": "/pages/our-story.html"
    },
    {
      "source": "/our-stories",
      "destination": "/pages/our-story.html"
    },
    {
      "source": "/activities",
      "destination": "/pages/our-work.html"
    },
    {
      "source": "/our-work",
      "destination": "/pages/our-work.html"
    },
    {
      "source": "/our-analytics",
      "destination": "/pages/our-analytics.html"
    },
    {
      "source": "/get-involved",
      "destination": "/pages/get-involved.html"
    },
    {
      "source": "/:file.css",
      "destination": "/pages/:file.css"
    }
  ]
}
