{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/our-analytics",
      "destination": "https://dashboard.climateactionenergyaccess.com/",
      "permanent": true
    },
    {
      "source": "/pages/our-analytics.html",
      "destination": "https://dashboard.climateactionenergyaccess.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/our-story",
      "destination": "/pages/our-story.html"
    },
    {
      "source": "/our-stories",
      "destination": "/pages/our-story.html"
    },
    {
      "source": "/activities",
      "destination": "/pages/our-work.html"
    },
    {
      "source": "/our-work",
      "destination": "/pages/our-work.html"
    },
    {
      "source": "/get-involved",
      "destination": "/pages/get-involved.html"
    },
    {
      "source": "/styles.css",
      "destination": "/assets/css/styles.css"
    },
    {
      "source": "/home.css",
      "destination": "/assets/css/home.css"
    },
    {
      "source": "/script.js",
      "destination": "/assets/js/script.js"
    },
    {
      "source": "/data-store.js",
      "destination": "/assets/js/data-store.js"
    },
    {
      "source": "/device-detect.js",
      "destination": "/assets/js/device-detect.js"
    },
    {
      "source": "/analytics.js",
      "destination": "/assets/js/analytics.js"
    },
    {
      "source": "/Assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:file.css",
      "destination": "/pages/:file.css"
    }
  ]
}
