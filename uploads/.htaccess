# Disable script execution in uploads directory (Compatible with Apache 2.4 and LiteSpeed)
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|asp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
